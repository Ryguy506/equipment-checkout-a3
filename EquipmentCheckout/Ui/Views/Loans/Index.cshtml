@model List<EquipmentCheckout.Ui.ReadModels.LoanRow>

@{
    ViewData["Title"] = "Loans";
}

<h2 class="mb-4">Active Loans</h2>


<table class="table table-striped table-bordered">
    <thead class="table-dark">
        <tr>
            <th>Borrower</th>
            <th>Equipment</th>
            <th>Loan Date</th>
            <th>Due Date</th>
            <th></th>
        </tr>
    </thead>

    <tbody>
        @foreach (var loan in Model)
        {
            <tr>
                <td>@loan.BorrowerName</td>
                <td>@loan.EquipmentName</td>
                <td>@loan.LoanDate.ToShortDateString()</td>
                <td>@loan.DueDate.ToShortDateString()</td>

                <td>
                    <form asp-action="Return" method="post">
                        <input type="hidden" name="loanId" value="@loan.LoanId" />

                        <button type="submit" class="btn btn-sm btn-danger">
                            Return
                        </button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>

<a asp-action="New" class="btn btn-primary">
    New Loan
</a>
@model EquipmentCheckout.Ui.ViewModels.NewLoanVm

@{
    ViewData["Title"] = "New Loan";
}

<h2 class="mb-4">Create New Loan</h2>

@if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
{
    <div class="alert alert-danger">
        @Model.ErrorMessage
    </div>
}

<form asp-action="New" method="post" class="card p-3">

    <div class="mb-3">
        <label class="form-label">Borrower</label>
        <select class="form-select" asp-for="BorrowerId">
            <option value="0">-- Select borrower --</option>
            @foreach (var b in Model.Borrowers)
            {
                <option value="@b.Id">
                    @b.Name (@b.StudentNumber) @(b.IsActive ? "" : "[INACTIVE]")
                </option>
            }
        </select>
    </div>

    <div class="mb-3">
        <label class="form-label">Equipment Item</label>
        <select class="form-select" asp-for="EquipmentItemId">
            <option value="0">-- Select equipment --</option>
            @foreach (var e in Model.Equipment)
            {
                <option value="@e.Id">
                    @e.Name - @e.Category @(e.IsActive ? "" : "[INACTIVE]")
                </option>
            }
        </select>
    </div>

    <div class="mb-3">
        <label class="form-label">Duration (days)</label>
        <input class="form-control" asp-for="DurationDays" type="number"  />
    </div>

    <div class="d-flex gap-2">
        <button type="submit" class="btn btn-primary">Create Loan</button>
        <a asp-action="Index" class="btn btn-secondary">Cancel</a>
    </div>
</form>
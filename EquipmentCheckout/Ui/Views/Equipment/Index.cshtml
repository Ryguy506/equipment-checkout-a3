@model List<EquipmentCheckout.Ui.ReadModels.EquipmentOption>

<h2 class="mb-4">Equipment</h2>

<table class="table table-striped table-bordered">
    <thead class="table-dark">
        <tr>
            <th>Name</th>
            <th>Category</th>
            <th>Active</th>
            <th>Actions</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Name</td>
                <td>@item.Category</td>
                <td>
                    @(item.IsActive ? "Yes" : "No")
                </td>
                <td>
                    <a asp-action="Create" asp-controller="Holds" asp-route-itemId="@item.Id" class="btn btn-sm btn-warning">
                        Place Hold
                    </a>

                    <a asp-action="Item" asp-controller="Holds" asp-route-itemId="@item.Id" class="btn btn-sm btn-info">View Holds</a>

                </td>
            </tr>
        }
    </tbody>
</table>
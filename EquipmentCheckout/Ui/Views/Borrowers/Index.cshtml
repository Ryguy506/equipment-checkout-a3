@model List<EquipmentCheckout.Ui.ReadModels.BorrowerOption>

<h2 class="mb-4">Borrowers</h2>

<table class="table table-striped table-bordered">
    <thead class="table-dark">
        <tr>
            <th>Name</th>
            <th>Student Number</th>
            <th>Active</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var borrower in Model)
        {
            <tr>
                <td>@borrower.Name</td>
                <td>@borrower.StudentNumber</td>
                <td>@(borrower.IsActive ? "Yes" : "No")</td>
            </tr>
        }
    </tbody>
</table>
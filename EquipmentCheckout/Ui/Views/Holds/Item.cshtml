@model EquipmentCheckout.Ui.ViewModels.CreateHoldVm


<h2 class="mb-4">Hold Queue</h2>

@if (!Model.Holds.Any())
{
    <p>No holds for this item.</p>
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th>Queue Position</th>
                <th>Borrower</th>
                <th>Date Placed</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var hold in Model.Holds)
            {
                <tr>
                    <td>@hold.QueuePosition</td>
                    <td>@hold.BorrowerName</td>
                    <td>@hold.DatePlaced.ToShortDateString()</td>
                </tr>
            }
        </tbody>
    </table>
}

<h2 class="mb-4">Place Hold</h2>

@if (Model.ErrorMessage != null)
{
    <div class="alert alert-danger">
        @Model.ErrorMessage
    </div>
}

<form method="post" asp-action="Create" asp-controller="Holds">

    <input type="hidden" asp-for="EquipmentItemId" />

    <div class="mb-3">
        <label class="form-label">Borrower</label>

        <select asp-for="BorrowerId" class="form-select">
            <option value="">Select Borrower</option>

            @foreach (var b in Model.Borrowers)
            {
                <option value="@b.Id">
                    @b.Name
                </option>
            }
        </select>
    </div>

    <button type="submit" class="btn btn-warning">
        Place Hold
    </button>

    <a href="/equipment" class="btn btn-secondary">
        Cancel
    </a>

</form>